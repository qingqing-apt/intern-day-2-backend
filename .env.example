# 数据库地址（容器内默认写入 /data 卷，本地开发用 ./data）
DATABASE_URL=sqlite:///./data/app.db

# 允许的前端来源，多个用逗号分隔（CORS）
ALLOWED_ORIGINS=http://localhost:5173

# 登录会话有效期（分钟）
SESSION_TTL_MINUTES=120

# 采集间隔（秒）与保留的样本数量（约 retention × interval 时长）
COLLECT_INTERVAL_SECONDS=5
METRICS_RETENTION=720

# 练习账号（仅虚构数据，禁止写真实密码）
SEED_USERNAME=intern
SEED_PASSWORD=intern-pass-123

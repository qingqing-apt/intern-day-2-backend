{
  "name": "intern-day-2-backend",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3"
      }
    }
  },
  "forwardPorts": [8000],
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && uv sync --frozen",
  "remoteUser": "root"
}
